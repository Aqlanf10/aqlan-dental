<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AqlanDentalPro.API</RootNamespace>
    <UserSecretsId>aqlan-dental-pro-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AqlanDentalPro.UnitTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AqlanDentalPro.Infrastructure\AqlanDentalPro.Infrastructure.csproj" />
    <ProjectReference Include="..\AqlanDentalPro.Application\AqlanDentalPro.Application.csproj" />
    <ProjectReference Include="..\AqlanDentalPro.Domain\AqlanDentalPro.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="QuestPDF" Version="2026.5.0" />
    <!-- Server-side rendering of prepared orthodontic report images (crop/zoom/rotate/
         flip/brightness/contrast/aspect). NoDependencies native asset works on headless
         Linux containers (Railway). Rendering is best-effort and never blocks a save. -->
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.8" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.8.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <!-- Ensure font files and logo are copied to API output for QuestPDF at runtime -->
  <ItemGroup>
    <Content Include="..\..\Fonts\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Fonts\" />
  </ItemGroup>
</Project>
