{
  "expo": {
    "name": "Aqlan Dental Pro",
    "slug": "aqlan-dental-pro",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "aqlandental",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aqlan.dentalpro"
    },
    "android": {
      "package": "com.aqlan.dentalpro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "السماح لـ Aqlan Dental Pro بالتحقق من هويتك."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
