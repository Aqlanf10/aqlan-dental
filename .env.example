# ============================================================
# Aqlan Dental Pro — Environment Variables
# Copy to .env and fill in values before running
# ============================================================

# ---- PostgreSQL (REQUIRED) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aqlan_dental
POSTGRES_USER=aqlan
POSTGRES_PASSWORD=change_me_strong_password

# ---- Redis (REQUIRED) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# ---- JWT (REQUIRED) ----
# SecretKey must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET_KEY=change_me_at_least_64_chars_long_random_string_here_for_security
JWT_ISSUER=AqlanDentalPro
JWT_AUDIENCE=AqlanDentalProClient
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ---- .NET Backend ----
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
BACKEND_PORT=5000

# ---- Database Connection (REQUIRED for backend) ----
# Used by EF Core / AppDbContext. Overrides POSTGRES_* for direct connection.
# Format: Host=...;Port=...;Database=...;Username=...;Password=...
# CONNECTION_STRING=

# ---- Next.js Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:5000
# Server-side RSC fetching (internal docker network)
API_URL=http://backend:8080
NEXT_PUBLIC_APP_NAME=Aqlan Dental Pro
FRONTEND_PORT=3000

# ---- Startup DB Maintenance (OPTIONAL) ----
# When true, runs migrations and seed on startup with advisory lock.
# Required for first deployment. Can be disabled after initial setup.
ENABLE_STARTUP_DB_MAINTENANCE=true
# Advisory lock key for DB maintenance (prevent multiple instances from running migration)
DB_MAINTENANCE_LOCK_KEY=918273645

# ---- Admin Default Password (OPTIONAL) ----
# Used on first startup to set admin password. If not set, falls back to a default.
# IMPORTANT: Set this in production! The fallback default is insecure.
ADMIN_DEFAULT_PASSWORD=ChangeMeImmediately2026!

# ---- File Uploads (OPTIONAL) ----
# Path for uploaded files. Defaults to wwwroot/uploads or /tmp/aqlan-uploads.
# Required for Railway/docker persistent volumes.
# UPLOADS_PATH=/data/uploads

# ---- CORS Allowed Origins (OPTIONAL) ----
# Comma-separated list of allowed frontend origins.
# Defaults to http://localhost:3000,http://localhost:3001
# AllowedOrigins=https://aqlan-dental-pro.vercel.app,https://aqlan-dental.vercel.app

# ---- reCAPTCHA (OPTIONAL) ----
# Google reCAPTCHA v3 for public booking and portal forgot-password.
# RECAPTCHA_SECRET_KEY=

# ---- pgAdmin (optional dev tool) ----
PGADMIN_DEFAULT_EMAIL=admin@aqlan.dev
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password

# ---- File Storage (Phase 3+) ----
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=

# ---- Email (Phase 5+) ----
# SENDGRID_API_KEY=
# EMAIL_FROM=noreply@aqlan-dental.com

# ---- WhatsApp API ----
# Used for appointment reminders, OTP, and notifications.
# WhatsApp:ApiUrl and WhatsApp:ApiToken are the actual config keys used by the backend.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# WhatsApp__ApiUrl=https://api.ultramsg.com/instanceXXX/messages
# WhatsApp__ApiToken=your_ultramsg_token
# WhatsApp__AdminPhone=967770245745
# WhatsApp__ClinicPhone=967770245745
# WhatsApp__DemoMode=true

# ---- AI / Claude API (Phase 6+) ----
# ANTHROPIC_API_KEY=
