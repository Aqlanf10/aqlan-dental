{
  "expo": {
    "name": "Aqlan Dental Pro",
    "slug": "aqlan-dental-pro",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "aqlandental",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aqlan.dentalpro"
    },
    "android": {
      "package": "com.aqlan.dentalpro",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a3a5c",
          "image": "./assets/logo-white.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "السماح لـ Aqlan Dental Pro بالتحقق من هويتك."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "السماح لـ Aqlan Dental Pro بالوصول إلى الصور لإضافتها إلى السجل السريري للمريض.",
          "cameraPermission": "السماح لـ Aqlan Dental Pro باستخدام الكاميرا لالتقاط الصور السريرية.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
