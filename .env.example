# ============================================================
# Aqlan Dental Pro — Environment Variables
# Copy to .env and fill in values before running
# ============================================================

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aqlan_dental
POSTGRES_USER=aqlan
POSTGRES_PASSWORD=change_me_strong_password

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# ---- JWT ----
JWT_SECRET_KEY=change_me_at_least_64_chars_long_random_string_here_for_security
JWT_ISSUER=AqlanDentalPro
JWT_AUDIENCE=AqlanDentalProClient
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ---- .NET Backend ----
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
BACKEND_PORT=5000

# ---- Next.js Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:5000
# Server-side RSC fetching (internal docker network)
API_URL=http://backend:8080
NEXT_PUBLIC_APP_NAME=Aqlan Dental Pro
FRONTEND_PORT=3000

# ---- pgAdmin (optional dev tool) ----
PGADMIN_DEFAULT_EMAIL=admin@aqlan.dev
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password

# ---- File Storage (Phase 3+) ----
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=

# ---- Email (Phase 5+) ----
# SENDGRID_API_KEY=
# EMAIL_FROM=noreply@aqlan-dental.com

# ---- WhatsApp (Phase 7+) ----
