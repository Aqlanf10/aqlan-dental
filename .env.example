# ============================================================
# Aqlan Dental Pro — Environment Variables
# Copy to .env and fill in values before running
# ============================================================

# ---- PostgreSQL (REQUIRED) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aqlan_dental
POSTGRES_USER=aqlan
POSTGRES_PASSWORD=change_me_strong_password

# ---- Redis (REQUIRED) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# ---- JWT (REQUIRED) ----
# SecretKey must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET_KEY=change_me_at_least_64_chars_long_random_string_here_for_security
JWT_ISSUER=AqlanDentalPro
JWT_AUDIENCE=AqlanDentalProClient
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ---- .NET Backend ----
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
BACKEND_PORT=5000

# ---- Database Connection (REQUIRED for backend) ----
# Used by EF Core / AppDbContext. Overrides POSTGRES_* for direct connection.
# Format: Host=...;Port=...;Database=...;Username=...;Password=...
# CONNECTION_STRING=

# ---- Next.js Frontend ----
# Client-side API URL (accessible from browser)
NEXT_PUBLIC_API_URL=http://localhost:5000
# Server-side API proxy destination (used by next.config.mjs rewrites)
BACKEND_URL=http://localhost:5000
# Server-side RSC fetching (internal docker network)
API_URL=http://backend:8080
NEXT_PUBLIC_APP_NAME=Aqlan Dental Pro
FRONTEND_PORT=3000

# ---- Startup DB Maintenance (OPTIONAL) ----
# When true, runs migrations and seed on startup with advisory lock.
# Required for first deployment. Can be disabled after initial setup.
ENABLE_STARTUP_DB_MAINTENANCE=true
# Advisory lock key for DB maintenance (prevent multiple instances from running migration)
DB_MAINTENANCE_LOCK_KEY=918273645

# ---- Admin Default Password (OPTIONAL) ----
# Used on first startup to set admin password via Program.cs one-time reset.
# If not set in production: admin password is NOT reset (secure).
# If not set in development: falls back to hardcoded dev-only password.
# IMPORTANT: Set this in production! Not setting it means the admin keeps the seed password.
ADMIN_DEFAULT_PASSWORD=ChangeMeImmediately2026!

# ---- Admin Reset Password (OPTIONAL) ----
# Used by DbSeeder to reset admin password on startup (separate from ADMIN_DEFAULT_PASSWORD).
# CFG-01 FIX: Documented previously undocumented env var used in DbSeeder.cs
# ADMIN_RESET_PASSWORD=

# ---- Admin Email (STRONGLY RECOMMENDED) ----
# Sets the admin user's email address on startup. Required for the forgot-password
# email flow — without it, the admin cannot receive a password reset link via email.
# If not set and admin forgets their password, the only recovery option is
# ADMIN_RESET_PASSWORD (which requires redeployment) or manual DB intervention.
# Example: ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_EMAIL=

# ---- File Uploads (OPTIONAL) ----
# Path for uploaded files. Defaults to wwwroot/uploads or /tmp/aqlan-uploads.
# Required for Railway/docker persistent volumes.
# UPLOADS_PATH=/data/uploads

# ---- Cephalometric Pilot Private Storage (REQUIRED for Pilot in production) ----
# Private persistent volume for de-identified Pilot images and comparator exports.
# Do not place this path under wwwroot, UPLOADS_PATH, or any static-file directory.
# CEPH_PILOT_STORAGE_PATH=/data/ceph-pilot-private

# ---- CORS Allowed Origins (OPTIONAL) ----
# Comma-separated list of allowed frontend origins.
# Defaults to http://localhost:3000,http://localhost:3001
# AllowedOrigins=https://aqlan-dental-pro.vercel.app,https://aqlan-dental.vercel.app

# ---- reCAPTCHA (OPTIONAL) ----
# Google reCAPTCHA v3 for public booking and portal forgot-password.
# Backend secret key (used by RecaptchaService.cs)
# RECAPTCHA_SECRET_KEY=
# Minimum score threshold for reCAPTCHA validation (default: 0.5)
# Recaptcha__MinimumScore=0.5
# Frontend site key (used in recaptcha.tsx)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ---- Patient Number Prefix (OPTIONAL) ----
# Prefix for auto-generated patient numbers (default: "GM")
# Used by PatientService.cs via Settings:PatientNumberPrefix config key
# In .env, use double-underscore for nested config: Settings__PatientNumberPrefix
# Settings__PatientNumberPrefix=GM

# ---- pgAdmin (optional dev tool) ----
PGADMIN_DEFAULT_EMAIL=admin@aqlan.dev
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password

# ---- File Storage (Phase 3+) ----
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=

# ---- Email / SMTP (REQUIRED for forgot-password email flow) ----
# Two email providers are supported: Resend API (recommended) and SMTP (fallback).
#
# RECOMMENDED: Resend API (https://resend.com — free 100 emails/day)
#   Works from any cloud server. Just sign up and copy your API key.
# RESEND_API_KEY=re_xxxxxxxxxxxxx
#
# FALLBACK: SMTP (may be blocked by Gmail from cloud servers like Railway)
# Gmail setup: Generate an App Password at https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USERNAME=you@gmail.com  SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
#
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@aqlandental.com
# SMTP_FROM_NAME=مركز د. عقلان الكامل
# APP_PUBLIC_URL=https://aqlan-dental.vercel.app

# ---- WhatsApp API ----
# Used for appointment reminders, OTP, and notifications.
# WhatsApp:ApiUrl and WhatsApp:ApiToken are the actual config keys used by the backend.
# In .env files, use double-underscore (__) to map to .NET config colon (:) notation.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# WhatsApp__ApiUrl=https://api.ultramsg.com/instanceXXX/messages
# WhatsApp__ApiToken=your_ultramsg_token
# WhatsApp__AdminPhone=967770245745
# WhatsApp__ClinicPhone=967770245745
# WhatsApp__DemoMode=true

# ---- AI / Claude API (Phase 6+) ----
# ANTHROPIC_API_KEY=

# ============================================================
# .NET Config Key Mapping Reference (CFG-01 FIX)
# ============================================================
# .NET Configuration uses colon (:) for nested keys in appsettings.json,
# but environment variables must use double-underscore (__).
#
# | appsettings.json key     | Environment variable       |
# |--------------------------|----------------------------|
# | ConnectionStrings:DefaultConnection | CONNECTION_STRING or ConnectionStrings__DefaultConnection |
# | Redis:ConnectionString   | Redis__ConnectionString    |
# | Jwt:SecretKey            | JWT_SECRET_KEY or Jwt__SecretKey |
# | Jwt:Issuer               | JWT_ISSUER or Jwt__Issuer  |
# | Jwt:Audience             | JWT_AUDIENCE or Jwt__Audience |
# | Jwt:AccessTokenExpiryMinutes | JWT_ACCESS_TOKEN_EXPIRY_MINUTES or Jwt__AccessTokenExpiryMinutes |
# | Jwt:RefreshTokenExpiryDays | JWT_REFRESH_TOKEN_EXPIRY_DAYS or Jwt__RefreshTokenExpiryDays |
# | AllowedOrigins           | AllowedOrigins             |
# | WhatsApp:ApiUrl          | WhatsApp__ApiUrl           |
# | WhatsApp:ApiToken        | WhatsApp__ApiToken         |
# | Recaptcha:SecretKey      | RECAPTCHA_SECRET_KEY or Recaptcha__SecretKey |
# | Recaptcha:MinimumScore   | Recaptcha__MinimumScore    |
# | Settings:PatientNumberPrefix | Settings__PatientNumberPrefix |
# ============================================================
