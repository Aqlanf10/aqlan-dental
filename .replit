modules = ["nodejs-24", "dotnet-8.0", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
AQLAN_DEV_JWT_SECRET = "EpXq4HLYi35msX8J8YZkyUFkxmjxsbXqU0zNrvLubXBu8Qkat03xAHnhBMlM9KCP"
ASPNETCORE_ENVIRONMENT = "Development"

[nix]
channel = "stable-25_05"
