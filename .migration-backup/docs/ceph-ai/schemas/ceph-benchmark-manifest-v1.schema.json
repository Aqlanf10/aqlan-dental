{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aqlan.dental/schemas/ceph-benchmark-manifest-v1.schema.json",
  "title": "Aqlan Dental Pro cephalometric benchmark manifest",
  "description": "De-identified, patient-clustered lateral cephalometric gold-standard manifest. Images and direct clinical identifiers are intentionally outside this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetVersion",
    "landmarkDefinitionVersion",
    "createdAt",
    "cases"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "datasetVersion": { "$ref": "#/$defs/versionToken" },
    "landmarkDefinitionVersion": { "const": "ADP-LM-LAT-v1" },
    "createdAt": { "$ref": "#/$defs/utcTimestamp" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/benchmarkCase" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "versionToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "opaqueCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,31}$"
    },
    "reviewerAlias": {
      "type": "string",
      "pattern": "^REV-[A-Z0-9]{4,32}$"
    },
    "landmarkKey": {
      "enum": [
        "S", "N", "Or", "Po", "ANS", "PNS", "A", "B", "Pog", "Gn", "Me", "Go",
        "Co", "Ar", "D", "Pm", "U1T", "U1A", "L1T", "L1A", "LS", "LI", "Pn", "Cm",
        "SPog", "U6", "L6"
      ]
    },
    "benchmarkCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imageId",
        "patientGroupId",
        "imageSha256",
        "imageWidth",
        "imageHeight",
        "millimetresPerPixel",
        "sourceSiteCode",
        "deviceCode",
        "split",
        "orientation",
        "ageBand",
        "skeletalClass",
        "anglePattern",
        "qualityFlags",
        "deidentification",
        "annotations",
        "goldStandard"
      ],
      "properties": {
        "imageId": { "type": "string", "format": "uuid" },
        "patientGroupId": { "$ref": "#/$defs/sha256" },
        "imageSha256": { "$ref": "#/$defs/sha256" },
        "imageWidth": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "imageHeight": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "millimetresPerPixel": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
        "sourceSiteCode": { "$ref": "#/$defs/opaqueCode" },
        "deviceCode": { "$ref": "#/$defs/opaqueCode" },
        "split": { "enum": ["Training", "Validation", "InternalTest", "ExternalClinicalTest"] },
        "orientation": { "const": "RightFacing" },
        "ageBand": { "enum": ["Unknown", "Pediatric", "Adult"] },
        "skeletalClass": { "enum": ["Unknown", "ClassI", "ClassII", "ClassIII"] },
        "anglePattern": { "enum": ["Unknown", "Low", "Average", "High"] },
        "qualityFlags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Normal", "LowContrast", "Blurred", "DoubleContour", "MetallicArtifact",
              "MissingAnatomy", "SevereCrop", "LowResolution"
            ]
          }
        },
        "deidentification": { "$ref": "#/$defs/deidentification" },
        "annotations": {
          "type": "array",
          "minItems": 48,
          "items": { "$ref": "#/$defs/reviewerAnnotation" }
        },
        "goldStandard": {
          "type": "array",
          "minItems": 24,
          "items": { "$ref": "#/$defs/goldStandardPoint" }
        }
      }
    },
    "deidentification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadataProfileVersion",
        "sanitizedAt",
        "stewardAlias",
        "dataUseApprovalId",
        "metadataSanitized",
        "privateTagsRemoved",
        "pixelInspectionStatus",
        "burnedInIdentifierDetected"
      ],
      "properties": {
        "metadataProfileVersion": { "$ref": "#/$defs/versionToken" },
        "sanitizedAt": { "$ref": "#/$defs/utcTimestamp" },
        "stewardAlias": { "type": "string", "pattern": "^STW-[A-Z0-9]{4,32}$" },
        "dataUseApprovalId": { "type": "string", "pattern": "^APP-[A-Z0-9-]{4,48}$" },
        "metadataSanitized": { "const": true },
        "privateTagsRemoved": { "const": true },
        "pixelInspectionStatus": { "const": "Passed" },
        "burnedInIdentifierDetected": { "const": false }
      }
    },
    "reviewerAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "landmarkKey",
        "reviewerAlias",
        "visibility",
        "x",
        "y",
        "doubleContourDecision",
        "annotatedAt"
      ],
      "properties": {
        "landmarkKey": { "$ref": "#/$defs/landmarkKey" },
        "reviewerAlias": { "$ref": "#/$defs/reviewerAlias" },
        "visibility": { "enum": ["Visible", "NotVisible", "Uncertain"] },
        "x": { "type": ["number", "null"], "minimum": 0 },
        "y": { "type": ["number", "null"], "minimum": 0 },
        "doubleContourDecision": {
          "enum": ["NotApplicable", "ReceptorSide", "ExplicitProtocolSide"]
        },
        "annotatedAt": { "$ref": "#/$defs/utcTimestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "visibility": { "const": "NotVisible" } }, "required": ["visibility"] },
          "then": { "properties": { "x": { "type": "null" }, "y": { "type": "null" } } },
          "else": { "properties": { "x": { "type": "number" }, "y": { "type": "number" } } }
        }
      ]
    },
    "goldStandardPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "landmarkKey",
        "visibility",
        "x",
        "y",
        "method",
        "decisionCodes",
        "approvedByAlias",
        "approvedAt"
      ],
      "properties": {
        "landmarkKey": { "$ref": "#/$defs/landmarkKey" },
        "visibility": { "enum": ["Visible", "NotVisible"] },
        "x": { "type": ["number", "null"], "minimum": 0 },
        "y": { "type": ["number", "null"], "minimum": 0 },
        "method": { "enum": ["ConsensusWithinThreshold", "ThirdReviewer", "ConsensusPanel"] },
        "decisionCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "CoordinateAgreement", "VisibilityResolved", "DoubleContourResolved",
              "CoordinateDisagreementResolved", "AnatomyNotVisible"
            ]
          }
        },
        "approvedByAlias": { "$ref": "#/$defs/reviewerAlias" },
        "approvedAt": { "$ref": "#/$defs/utcTimestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "visibility": { "const": "NotVisible" } }, "required": ["visibility"] },
          "then": {
            "properties": {
              "x": { "type": "null" },
              "y": { "type": "null" },
              "decisionCodes": { "contains": { "const": "AnatomyNotVisible" } }
            }
          },
          "else": { "properties": { "x": { "type": "number" }, "y": { "type": "number" } } }
        }
      ]
    }
  }
}
