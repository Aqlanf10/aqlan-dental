{
  "expo": {
    "name": "Aqlan Dental Pro",
    "slug": "aqlan-dental-pro",
    "version": "0.1.1",
    "orientation": "portrait",
    "scheme": "aqlandental",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aqlan.dentalpro"
    },
    "android": {
      "package": "com.aqlan.dentalpro",
      "versionCode": 2
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "السماح لـ Aqlan Dental Pro بالتحقق من هويتك."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "السماح لـ Aqlan Dental Pro بالوصول إلى الصور لإضافتها إلى السجل السريري للمريض.",
          "cameraPermission": "السماح لـ Aqlan Dental Pro باستخدام الكاميرا لالتقاط الصور السريرية.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
